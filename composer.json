{
  "name": "sociolink/api-resource-bundle",
  "description": "Génère les ressources API Platform (DTOs, State Processors/Providers, filtres QueryParameter) à partir des entités Doctrine — outil de développement, jamais requis en production.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "authors": [
    {
      "name": "Xavier KONGOLO",
      "email": "xsompwe@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "ext-tokenizer": "*",
    "api-platform/core": "^5.0",
    "doctrine/dbal": "^4.0",
    "doctrine/inflector": "^2.0",
    "doctrine/orm": "^3.0",
    "nikic/php-parser": "^5.0",
    "symfony/config": "^7.4 || ^8.0",
    "symfony/console": "^7.4 || ^8.0",
    "symfony/dependency-injection": "^7.4 || ^8.0",
    "symfony/filesystem": "^7.4 || ^8.0",
    "symfony/http-kernel": "^7.4 || ^8.0",
    "twig/twig": "^3.0"
  },
  "require-dev": {
    "ext-pdo_sqlite": "*",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^11.0",
    "symfony/framework-bundle": "^7.4 || ^8.0"
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=1G",
    "check": ["@analyse", "@test"]
  },
  "autoload": {
    "psr-4": {
      "SocioLink\\ApiResourceBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SocioLink\\ApiResourceBundle\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "symfony/flex": true
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0-dev"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}

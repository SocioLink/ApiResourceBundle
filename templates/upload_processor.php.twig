    public function process(mixed $data, Operation $operation, array $uriVariables = [], array $context = []): mixed
    {
        if (!$data instanceof {{ entity_name }}) {
            throw new BadRequestHttpException('{{ entity_name }} introuvable.');
        }

        $request = $context['request'] ?? null;

        if (!$request instanceof Request) {
            throw new BadRequestHttpException('Requête introuvable.');
        }

        $file = $request->files->get('{{ field_name }}');

        if (!$file instanceof UploadedFile) {
            throw new BadRequestHttpException('Fichier « {{ field_name }} » manquant.');
        }

        /* Les contraintes #[Assert\File] portées par le DTO sont vérifiées avant toute modification de l'entité. */
        $dto = new {{ dto_class }}();
        $dto->{{ field_name }} = $file;

        $errors = $this->validator->validate($dto);

        if (count($errors) > 0) {
            throw new ApiValidationException($errors);
        }

        $data->{{ field_setter }}($file);
{% if has_updated_at %}
        $data->setUpdatedAt(new DateTimeImmutable());
{% endif %}

        return $this->persistProcessor->process($data, $operation, $uriVariables, $context);

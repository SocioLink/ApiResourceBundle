/**
 * Provider de lecture unitaire pour l'entité {{ entity_name }} — opération GET /{id}.
 *
 * Charge l'entité par son identifiant avec eager loading des relations ToOne
 * pour éviter le problème N+1 lors de la sérialisation.
 *
 * @implements ProviderInterface<{{ entity_name }}>
 */
final readonly class {{ entity_name }}Provider implements ProviderInterface
{
    public function __construct(
        private EntityManagerInterface $em,
    ) {}

    /**
     * @param Operation            $operation    Opération API Platform (GET)
     * @param array<string, mixed> $uriVariables Variables de l'URL
     * @param array<string, mixed> $context      Contexte de la requête API Platform
     *
     * @throws NotFoundHttpException si l'entité n'existe pas
     */
    public function provide(Operation $operation, array $uriVariables = [], array $context = []): object|array|null
    {
        $id = $uriVariables['id'] ?? null;

        if ($id === null) {
            throw new NotFoundHttpException('Identifiant manquant.');
        }

        if (is_string($id) && class_exists(Uuid::class) && Uuid::isValid($id)) {
            $id = Uuid::fromString($id);
        }

        $qb = $this->em->getRepository({{ entity_name }}::class)->createQueryBuilder('e');
{% for relation in eager_relations %}
        $qb->leftJoin('e.{{ relation.field }}', '{{ relation.alias }}')->addSelect('{{ relation.alias }}');
{% endfor %}

        $entity = $qb->where('e.id = :id')
            ->setParameter('id', $id)
            ->getQuery()
            ->getOneOrNullResult();

        if ($entity === null) {
            throw new NotFoundHttpException(sprintf('{{ entity_name }} "%s" introuvable.', (string) $id));
        }

        return $entity;
    }
}

/**
 * Processor de basculement du champ '{{ field_name }}' de l'entité {{ entity_name }}.
 *
 * @implements ProcessorInterface<{{ dto_class }}, {{ entity_name }}>
 *
 * @see {{ dto_class }}
 */
final readonly class {{ entity_name }}{{ pascal_name }}Processor implements ProcessorInterface
{
    public function __construct(
        #[Autowire(service: 'api_platform.doctrine.orm.state.persist_processor')]
        private ProcessorInterface $persistProcessor,
        private EntityManagerInterface $em,
        private ValidatorInterface $validator,
{% if needs_security %}
        private AppSecurity $security,
{% endif %}
    ) {}

    /**
     * @param mixed                $data         Données transmises (DTO désérialisé)
     * @param Operation            $operation    Opération API Platform (PATCH)
     * @param array<string, mixed> $uriVariables Variables de l'URL
     * @param array<string, mixed> $context      Contexte de la requête API Platform
     *
     * @return {{ entity_name }}
     */
    public function process(mixed $data, Operation $operation, array $uriVariables = [], array $context = []): mixed
    {
        if (!$data instanceof {{ dto_class }}) {
            throw new \InvalidArgumentException(sprintf('Données invalides : %s attendu, %s reçu.', {{ dto_class }}::class, get_debug_type($data)));
        }

        $id = $uriVariables['id'] ?? null;

        if ($id === null) {
            throw new \InvalidArgumentException('Identifiant manquant pour le chargement de l\'entité.');
        }

        if (is_string($id) && class_exists(Uuid::class) && Uuid::isValid($id)) {
            $id = Uuid::fromString($id);
        }

        $entity = $this->em->getRepository({{ entity_name }}::class)->find($id);

        if ($entity === null) {
            throw new NotFoundHttpException(sprintf('{{ entity_name }} "%s" introuvable.', (string) $id));
        }

{% if field_name == 'itDeleted' %}
{% include '_soft_delete.php.twig' %}
{% elseif field_name == 'itErased' %}
{% include '_soft_erase.php.twig' %}
{% else %}
        /* Mapping automatique (PATCH) : seules les valeurs non nulles sont appliquées. */
        foreach (new ReflectionObject($data)->getProperties() as $property) {
            $value = $property->getValue($data);

            if ($value === null) {
                continue;
            }

            $setter = 'set' . ucfirst($property->getName());

            if (method_exists($entity, $setter)) {
                $entity->$setter($value);
            }
        }
{% endif %}

        $errors = $this->validator->validate($entity);

        if (count($errors) > 0) {
            throw new ApiValidationException($errors);
        }

        return $this->persistProcessor->process($entity, $operation, $uriVariables, $context);
    }
}
